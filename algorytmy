import java.util.Scanner;
import java.util.ArrayList;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        // =========================
        // ZADANIE 1
        // =========================

        System.out.println("=== ZADANIE 1 ===");

        while (true) {
            System.out.print("Podaj wysokosc paczki [cm] (0 = dalej): ");
            float h = scanner.nextFloat();

            if (h == 0) {
                break;
            }

            if (h <= 8) {
                System.out.println("Gabaryt A - 12.00 PLN");
            } else {
                System.out.println("Gabaryt B - 16.00 PLN");
            }
        }


        // =========================
        // ZADANIE 2
        // =========================

        System.out.println("\n=== ZADANIE 2 ===");

        while (true) {
            System.out.print("Podaj wysokosc paczki [cm] (0 = dalej): ");
            float h = scanner.nextFloat();

            if (h == 0) {
                break;
            }

            System.out.print("Podaj wage paczki [kg]: ");
            float w = scanner.nextFloat();

            if (w == 0) {
                break;
            }

            if (h <= 0 || w <= 0) {
                System.out.println("Blad: wartosci musza byc dodatnie!");
            }
            else if (w > 25) {
                System.out.println("Odrzucono: przekroczono limit wagi 25 kg.");
            }
            else if (h <= 8) {
                System.out.println("Gabaryt A - 12.00 PLN");
            }
            else if (h <= 19) {
                System.out.println("Gabaryt B - 16.00 PLN");
            }
            else if (h <= 41) {
                System.out.println("Gabaryt C - 20.00 PLN");
            }
            else {
                System.out.println("Odrzucono: zbyt wysoka paczka.");
            }
        }


        // =========================
        // ZADANIE 3
        // =========================

        System.out.println("\n=== ZADANIE 3 ===");

        float suma = 0;
        int liczbaPaczek = 0;

        while (true) {
            System.out.print("Podaj wage paczki [kg] (0 = dalej): ");
            float waga = scanner.nextFloat();

            if (waga == 0) {
                break;
            }

            if (suma + waga <= 100) {
                suma += waga;
                liczbaPaczek++;

                System.out.println(
                    "Przyjeto. Laczna waga: " + suma + " kg"
                );
            } else {
                System.out.println(
                    "Odrzucono: przekroczono limit 100 kg!"
                );
            }
        }

        System.out.println("Liczba paczek: " + liczbaPaczek);
        System.out.println("Laczna waga: " + suma + " kg");


        // =========================
        // ZADANIE 4
        // =========================

        System.out.println("\n=== ZADANIE 4 ===");

        suma = 0;
        liczbaPaczek = 0;

        while (true) {
            System.out.print("Podaj wage paczki [kg] (0 = dalej): ");
            float waga = scanner.nextFloat();

            if (waga == 0) {
                break;
            }

            if (waga < 0) {
                System.out.println("Waga nie moze byc ujemna!");
                continue;
            }

            if (suma + waga <= 100) {
                suma += waga;
                liczbaPaczek++;

                System.out.println("Przyjeto paczke.");
            } else {
                System.out.println("Odrzucono: limit 100 kg!");
            }
        }

        System.out.println("Liczba paczek: " + liczbaPaczek);
        System.out.println("Laczna waga: " + suma + " kg");
        System.out.println("Wolne miejsce: " + (100 - suma) + " kg");


        // =========================
        // ZADANIE 5
        // =========================

        System.out.println("\n=== ZADANIE 5 ===");

        ArrayList<Float> paczki = new ArrayList<>();

        suma = 0;

        while (true) {
            System.out.print("Podaj wage paczki [kg] (0 = koniec): ");
            float waga = scanner.nextFloat();

            if (waga == 0) {
                break;
            }

            if (waga < 0) {
                System.out.println("Waga nie moze byc ujemna!");
                continue;
            }

            if (suma + waga <= 100) {
                suma += waga;
                paczki.add(waga);

                System.out.println("Przyjeto paczke.");
            } else {
                System.out.println("Odrzucono: przekroczono 100 kg!");
            }
        }

        System.out.println("\n--- RAPORT ---");

        System.out.println(
            "Liczba przyjetych paczek: " + paczki.size()
        );

        System.out.println(
            "Laczna waga: " + suma + " kg"
        );

        System.out.println(
            "Wolne miejsce: " + (100 - suma) + " kg"
        );

        if (paczki.size() > 0) {

            float min = paczki.get(0);
            float max = paczki.get(0);

            for (int i = 1; i < paczki.size(); i++) {

                if (paczki.get(i) < min) {
                    min = paczki.get(i);
                }

                if (paczki.get(i) > max) {
                    max = paczki.get(i);
                }
            }

            float srednia = suma / paczki.size();

            System.out.println("Najlzejsza paczka: " + min + " kg");
            System.out.println("Najciezsza paczka: " + max + " kg");
            System.out.println("Srednia waga: " + srednia + " kg");
        }

        scanner.close();
    }
}